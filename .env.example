# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is ignored by git — never commit real secrets.

# ---------- Database (development: SQL Server LocalDB) ----------
CONNECTIONSTRINGS__DEFAULT=Server=(localdb)\MSSQLLocalDB;Database=SuperApp;Trusted_Connection=True;TrustServerCertificate=True

# ---------- First CEO account (used once by the seed) ----------
SEED__CEO_EMAIL=
SEED__CEO_PASSWORD=
SEED__CEO_NAME=Sharaf
# true = load today's demo data (pitches, products, sellers, 18 paused AI agents…); false before the real launch
SEED__DEMODATA=true

# ---------- Security ----------
# Any long random strings (at least 32 characters each)
SECURITY__QR_SIGNING_KEY=
SECURITY__ENCRYPTION_KEY=
SECURITY__DATA_PROTECTION_KEYS_PATH=keys

# ---------- Email ----------
EMAIL__MODE=File
EMAIL__FROM=no-reply@superapp.local
EMAIL__FROM_NAME=Super App
EMAIL__FILE_FOLDER=emails
EMAIL__SMTP_HOST=
EMAIL__SMTP_PORT=587
EMAIL__SMTP_USER=
EMAIL__SMTP_PASSWORD=

# ---------- Payments (one block per provider; empty = simulated gateway) ----------
PAYMENTS__PAYMOB__SECRETKEY=
PAYMENTS__PAYMOB__PUBLICKEY=
PAYMENTS__PAYMOB__HMACSECRET=
# Paymob integration ids, comma list (card, mobile wallet…) — Paymob dashboard → Developers → Payment integrations
PAYMENTS__PAYMOB__INTEGRATIONIDS=
# The public https address of this server (Paymob calls {it}/api/v1/webhooks/payments/paymob and sends payers back to {it}/super-app/)
PAYMENTS__PUBLICBASEURL=

# ---------- Courier (empty = simulated courier) ----------
SHIPPING__BOSTA__APIKEY=
SHIPPING__BOSTA__WEBHOOKSECRET=

# ---------- Football data ----------
# Free sources are used by default (decision 2026-10-27): FPL for the English league (no key) and TheSportsDB for the
# others (free key 123). Leave the API-FOOTBALL key empty: its free plan has no current season.
FOOTBALL__APIFOOTBALL__KEY=
FOOTBALL__THESPORTSDB__KEY=123

# ---------- Geocoding, weather, holidays ----------
GEO__PROVIDER=Nominatim
GEO__USER_AGENT=SuperApp/1.0 (contact email)
GEO__APIKEY=
WEATHER__OPENMETEO__APIKEY=
HOLIDAYS__PROVIDER=NagerDate
HOLIDAYS__CALENDARIFIC__APIKEY=

# ---------- Automation (n8n) ----------
AUTOMATION__N8N__BASEURL=
AUTOMATION__WEBHOOK_SIGNING_KEY=

# ---------- Storage ----------
STORAGE__MODE=Local
STORAGE__LOCAL_ROOT=storage

# Reverse proxy (nginx on the VPS). 127.0.0.1 / ::1 are trusted already; add other proxy IPs, comma-separated
REVERSEPROXY__KNOWNPROXIES=
