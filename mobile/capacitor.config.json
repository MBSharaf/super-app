{
  "appId": "com.supermalaab.app",
  "appName": "Super Malaab",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "url": "https://supermalaab.com",
    "androidScheme": "https",
    "allowNavigation": [
      "supermalaab.com",
      "www.supermalaab.com"
    ],
    "errorPath": "offline.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#F1F2EE",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css"
    }
  }
}
