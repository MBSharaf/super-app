# Copy to tools/ops/backup.env (ignored by git) and fill in. Read by backup.sh and restore.sh.

# --- VPS (Linux, SQL Server for Linux) ---
SA_DB_SERVER=localhost
SA_DB_NAME=SuperApp
SA_DB_USER=sa
# sqlcmd reads the password from this variable, so it never shows in the process list
SQLCMDPASSWORD=
SA_APP_DIR=/var/www/superapp
SA_BACKUP_DIR=/var/backups/superapp
# Keep a copy of this passphrase OUTSIDE the server (password manager) — without it no backup can be opened
SA_BACKUP_PASSPHRASE=
SA_KEEP_DAYS=14
# Optional off-site copy with rclone (e.g. Backblaze B2, Google Drive): run `rclone config` once, then name the target
SA_OFFSITE=

# --- Local Windows (Git Bash, LocalDB) example ---
# SA_DB_SERVER=(localdb)\MSSQLLocalDB
# SA_DB_USER=
# SA_APP_DIR=/d/Super - App/src/SuperApp.Api
# SA_BACKUP_DIR=/d/SuperAppBackups
