# Apache / LiteSpeed hosting (cPanel) at the domain root: HTTPS only, clean URLs open index.html, no folder listings.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Let the free SSL check (AutoSSL / Let's Encrypt) reach its files over plain HTTP
  RewriteRule ^\.well-known/ - [L]
  # Always HTTPS and no "www."
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://supermalaab.com%{REQUEST_URI} [L,R=301]
  # Never serve source, planning or server files
  RewriteRule ^(\.git|docs|src|tests|tools|mobile|\.claude)(/|$) - [F,L]
  RewriteRule \.(md|sln|props|cs|csproj|ps1)$ - [F,L]
  # No server on this hosting yet: /api/ answers 404 so the site runs in demo mode instead of loading index.html
  RewriteRule ^api(/|$) - [R=404,L]
  # Any page address without a file (e.g. /fantasy/leagues) opens the app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
