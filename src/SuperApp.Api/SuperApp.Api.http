# Super App API — try the endpoints from Visual Studio or VS Code (REST Client).
# Run the API first (https profile). Requests are sent in order with the same cookies.
#
# How changes work: every POST / PUT / PATCH needs the anti-forgery token from GET /auth/csrf in the
# X-CSRF-TOKEN header. Run "csrf" first, copy data.token into @csrf below, and run it again after a sign-in.
# Fake values only — never put real passwords in this file.

@host = https://localhost:7254
@api = {{host}}/api/v1
@csrf = paste-the-token-here

### Health (no sign-in)
GET {{host}}/health/ready

### csrf — copy data.token into @csrf
GET {{api}}/auth/csrf
Accept: application/json

### Public lookups
GET {{api}}/lookups/governorates
Accept: application/json

###
GET {{api}}/lookups/settings/public
Accept: application/json

### Sign up (a test customer)
POST {{api}}/auth/sign-up
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "fullName": "Test Player",
  "email": "test.player@example.test",
  "phone": "01012345678",
  "password": "TestOnly2026",
  "acceptTerms": true,
  "language": "ar"
}

### Sign in (email or mobile) — then run csrf again
POST {{api}}/auth/sign-in
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "login": "test.player@example.test", "password": "TestOnly2026" }

### My account
GET {{api}}/me
Accept: application/json

### Change my name and language
PATCH {{api}}/me
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "fullName": "Test Player Two", "language": "en" }

### My applications
GET {{api}}/applications/mine
Accept: application/json

### Forgot password (always 202; the email is saved in src/SuperApp.Api/emails)
POST {{api}}/auth/forgot-password
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "email": "test.player@example.test" }

### Second step of sign-in for team accounts (code from the authenticator app)
POST {{api}}/auth/2fa/verify
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "code": "123456" }

### CEO: the team (needs the CEO signed in with the authenticator code)
GET {{api}}/ceo/admins
Accept: application/json

### CEO: roles and their permissions
GET {{api}}/ceo/roles
Accept: application/json

### Admin: applications waiting (needs an approvals permission + authenticator code)
GET {{api}}/admin/approvals?status=Pending
Accept: application/json

### Partner: my venues and pitches (signed in as a pitch partner or their staff)
GET {{api}}/partner/venues
Accept: application/json

###
GET {{api}}/partner/pitches
Accept: application/json

### Partner: add a pitch (waits for the admin's review). openingHours: 7 rows, closeHour up to 30 (26 = 2 AM)
POST {{api}}/partner/pitches
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "venueId": 1, "name": "Arena Five", "format": 5, "surface": "ArtificialTurf", "isIndoor": false, "pricePerHour": 600, "peakPricePerHour": 750, "peakFromHour": 18,
  "policyKey": "standard", "allowCash": true, "facilities": ["lights", "parking"],
  "openingHours": [ { "dayOfWeek": 0, "openHour": 9, "closeHour": 26, "isClosed": false }, { "dayOfWeek": 1, "openHour": 9, "closeHour": 26, "isClosed": false },
    { "dayOfWeek": 2, "openHour": 9, "closeHour": 26, "isClosed": false }, { "dayOfWeek": 3, "openHour": 9, "closeHour": 26, "isClosed": false },
    { "dayOfWeek": 4, "openHour": 9, "closeHour": 26, "isClosed": false }, { "dayOfWeek": 5, "openHour": 9, "closeHour": 26, "isClosed": false },
    { "dayOfWeek": 6, "openHour": 9, "closeHour": 26, "isClosed": false } ] }

### Partner: block hours (409 bookings_in_range when booked hours fall inside)
POST {{api}}/partner/pitches/1/closures
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "fromDate": "2026-11-01", "toDate": "2026-11-01", "fromHour": 9, "toHour": 12, "reason": "Maintenance" }

### Partner: bookings (status=upcoming|past|cancelled|noshow|all, q = code / name / phone)
GET {{api}}/partner/bookings?status=upcoming
Accept: application/json

### Partner: bookings as Excel (dashboard sheet first)
GET {{api}}/partner/bookings/export.xlsx?status=all

### Partner: walk-in (no fee, no commission)
POST {{api}}/partner/bookings/walk-in
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "pitchId": 1, "date": "2026-11-01", "hour": 20, "duration": 1, "name": "Captain Karim", "phone": "01012345678" }

### Partner: cancel a booking (the player gets a full refund)
POST {{api}}/partner/bookings/SA-XXXXXXXX/cancel
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "reason": "Floodlights repair" }

### Check-in: scan a QR token or a typed booking / package code (new Idempotency-Key each scan)
POST {{api}}/check-in/scan
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
Idempotency-Key: scan-0001

{ "code": "SA-XXXXXXXX", "pitchId": null, "device": "Front desk" }

### Packages: quote (public)
GET {{api}}/packages/quote?pitchSlug=zayed-22&optionId=1&startsOn=2026-11-05&hour=20&duration=1

### Packages: buy
POST {{api}}/packages
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "pitchSlug": "zayed-22", "optionId": 1, "startsOn": "2026-11-05", "hour": 20, "duration": 1, "acceptWaiver": true }

### Sign out
POST {{api}}/auth/sign-out
X-CSRF-TOKEN: {{csrf}}


############################################################
### Phase 4 — Shop & POD
############################################################

### Shop: products and live designs (public)
GET {{api}}/shop/products?category=boots&sort=price&page=1&pageSize=24

### Shop: product page
GET {{api}}/shop/products/sh-predator

### Shop: printed-design page
GET {{api}}/shop/designs/1

### Shop: report a design
POST {{api}}/shop/designs/1/report
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "reason": "Copyright", "detail": "This is my drawing", "contact": "me@example.com" }

### Store page and follow
GET {{api}}/stores/koora-ink

###
POST {{api}}/stores/koora-ink/follow
X-CSRF-TOKEN: {{csrf}}

### Cart (send ?promo=CODE to see a code applied)
GET {{api}}/cart?promo=SUPER10

### Cart: add a variant, or a design with size and colour
POST {{api}}/cart/items
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "designId": 1, "size": "M", "color": "Black", "qty": 1 }

### Cart: check a code
POST {{api}}/cart/promo
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "code": "SUPER10" }

### Wishlist
POST {{api}}/wishlist
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "productSlug": "sh-copa" }

### Checkout (new Idempotency-Key for each new order)
POST {{api}}/orders/checkout
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
Idempotency-Key: order-0001

{ "address": { "label": "Home", "line1": "12 Test Street, Dokki", "line2": "Floor 3", "city": "Giza" }, "phone": "01012345678", "deliverySpeed": "standard", "paymentMethod": "online", "promoCode": null }

### My orders, order page, tracking, receipt
GET {{api}}/orders/mine?status=open

###
GET {{api}}/orders/ORD-123456

###
GET {{api}}/orders/ORD-123456/tracking

###
GET {{api}}/orders/ORD-123456/receipt.pdf

### Cancel before work starts
POST {{api}}/orders/ORD-123456/cancel
X-CSRF-TOKEN: {{csrf}}

### Returns: what can be returned, request one
GET {{api}}/orders/ORD-123456/returnable

###
POST {{api}}/returns
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "orderCode": "ORD-123456", "reason": "WrongSize", "detail": null, "items": [ { "orderItemId": 1, "qty": 1, "action": "Exchange", "newSize": "L" } ] }

### Partner shop: profile, products, orders (the same tools under /seller/store and /admin/store)
GET {{api}}/partner/store

###
POST {{api}}/partner/store/products
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "name": "Grip Socks", "categoryKey": "accessories", "brand": "Turf", "description": "Anti-slip.", "price": 250, "compareAtPrice": 300, "lowStockAt": 3, "status": "Published",
  "specs": [ { "label": "Material", "value": "Cotton" } ],
  "variants": [ { "id": null, "size": "M", "colorName": "Black", "colorHex": "#000000", "sku": null, "stock": 10, "priceOverride": null } ] }

###
GET {{api}}/partner/store/orders?status=open

###
POST {{api}}/partner/store/orders/ORD-123456/pack
X-CSRF-TOKEN: {{csrf}}

###
POST {{api}}/partner/store/orders/ORD-123456/ship
X-CSRF-TOKEN: {{csrf}}

###
GET {{api}}/partner/returns

### Seller: overview, catalogue, designs
GET {{api}}/seller/overview

###
GET {{api}}/seller/catalogue

###
POST {{api}}/seller/designs
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "catalogProductId": 1 }

###
POST {{api}}/seller/designs/1/submit
X-CSRF-TOKEN: {{csrf}}

###
GET {{api}}/seller/orders

###
GET {{api}}/seller/analytics?from=2026-09-01&to=2026-10-18

### Factory: register a device (owner), then staff sign in with a PIN on it
POST {{api}}/factory/devices/register
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "name": "Packing tablet" }

###
GET {{api}}/factory/staff/list
X-Factory-Device: {{factoryDevice}}

###
POST {{api}}/factory/auth/pin
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
X-Factory-Device: {{factoryDevice}}

{ "staffId": 3, "pin": "3333" }

###
GET {{api}}/factory/jobs?stage=active
X-Factory-Device: {{factoryDevice}}
X-Factory-Session: {{factorySession}}

###
POST {{api}}/factory/jobs/JB-XXXXXXXX/advance
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
X-Factory-Device: {{factoryDevice}}
X-Factory-Session: {{factorySession}}

{ "toStage": "Printing", "note": null }

### Admin: design queue, reports, catalogue changes, shipments (2FA session)
GET {{api}}/admin/designs/queue

###
GET {{api}}/admin/design-reports

###
GET {{api}}/admin/catalogue-changes

###
GET {{api}}/admin/shipments?status=AwaitingPickup

###
POST {{api}}/admin/shipments/1/simulate
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{ "status": "Delivered" }