{
  "Features": {
    "StoreEnabled": false,
    "TournamentsOpen": false
  },
  "Automation": {
    "N8n": {
      "Orders": "",
      "Bookings": "",
      "Dashboard": "",
      "Support": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/superapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Site": {
    "Root": "../..",
    "Social": {
      "Facebook": "https://www.facebook.com/share/1KaqWPvmbE/",
      "Instagram": "https://www.instagram.com/supermalaab/"
    }
  },
  "Docs": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
